{
    "name": "daisy-firmware-loader",
    "version": "1.3.1",
    "description": "Aplicación para cargar firmwares a placas Daisy",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --mac",
        "build-dmg": "electron-builder --mac --dmg"
    },
    "keywords": [
        "daisy",
        "firmware",
        "dfu",
        "electrosmith"
    ],
    "author": "Xavioxi",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "build": {
        "appId": "com.xavioxi.daisy-firmware-loader",
        "productName": "Daisy Firmware Loader",
        "mac": {
            "category": "public.app-category.developer-tools",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "identity": null,
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "assets/icon.icns"
        },
        "files": [
            "**/*",
            "!bin/**/*",
            "!**/*.ts",
            "!*.md",
            "!dist"
        ],
        "extraResources": [
            {
                "from": "bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            }
        ]
    },
    "dependencies": {
        "intel-hex": "^0.2.0"
    }
}